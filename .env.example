# groq | gemini | openai | ollama | baseline (sans LLM)
LLM_PROVIDER=baseline

# Groq (gratuit) : https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# low | medium | high (modèles gpt-oss) — « low » économise beaucoup de tokens
GROQ_REASONING_EFFORT=

# Au-delà de cette attente demandée par l'API, l'évaluation se met en pause
# (résultats enregistrés, reprise avec --resume)
LLM_MAX_WAIT_SECONDS=90

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_HOST=http://localhost:11434
